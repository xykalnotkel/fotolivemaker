<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="22dp"
    android:paddingBottom="18dp">

    <!-- Handle Bar Minimalist -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_pill"
        android:alpha="0.25" />

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilihan"
        android:textColor="?attr/appTextHigh"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02" />

    <TextView
        android:id="@+id/tvDialogSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Pilih salah satu opsi di bawah"
        android:textColor="?attr/appTextDim"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/appLine" />

    <!-- Container Pilihan -->
    <LinearLayout
        android:id="@+id/containerChoices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogCancel"
        style="@style/Btn.Ghost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minHeight="46dp"
        android:text="TUTUP" />
</LinearLayout>
