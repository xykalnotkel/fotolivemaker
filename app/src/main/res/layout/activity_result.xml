<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    tools:ignore="UseCompoundDrawables"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/appIconTint"
            android:contentDescription="Kembali" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Hasil Live Photo"
            android:textColor="?attr/appTextHigh"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/appLine" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <!-- AREA TES: tahan untuk memutar -->
            <FrameLayout
                android:id="@+id/holdArea"
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:background="@drawable/bg_preview">

                <ImageView
                    android:id="@+id/still"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Foto diam" />

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:visibility="invisible"
                    app:use_controller="false"
                    app:resize_mode="fit" />

                <!-- Badge LIVE beraksen cobalt -->
                <LinearLayout
                    android:id="@+id/badgeLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_live"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:id="@+id/badgeIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_livephoto"
                        app:tint="#FFFFFFFF"
                        android:contentDescription="Live Photo" />

                    <TextView
                        android:id="@+id/badgeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="LIVE"
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <!-- Tombol Mode di Kanan Atas -->
                <LinearLayout
                    android:id="@+id/modeBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_pill_outline"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/modeStatic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="Statis"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="?attr/appInk" />

                    <TextView
                        android:id="@+id/modeLive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="Live"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="?attr/appAccent" />

                    <TextView
                        android:id="@+id/modeLoop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="Putar"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="?attr/appTextDim" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hintHold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_pill_outline"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Tahan untuk memutar"
                    android:textColor="?attr/appInk"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Status Utama -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_ok" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Memeriksa format…"
                        android:textColor="?attr/appTextHigh"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/statusSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tersimpan di DCIM/Camera"
                        android:textColor="?attr/appTextMid"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnRecheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Cek ulang"
                    android:textColor="?attr/appAccent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Rincian Pemeriksaan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verifikasi Struktur Berkas" />

                <TextView
                    android:id="@+id/chkStruct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="?attr/appTextMid"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chkVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/appTextMid"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chkSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/appTextMid"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="8dp"
                android:text="Lihat detail teknis"
                android:textColor="?attr/appTextMid"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="?attr/appTextMid"
                android:lineSpacingExtra="3dp" />

            <!-- Petunjuk Penggunaan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/illusResult"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginBottom="18dp"
                    android:src="@drawable/illus_hold_preview"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="Tahan layar" />

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Photo atau video" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Untuk label LIVE di WA &amp; TikTok Android 2026, kirim JPG Motion Photo langsung. WhatsApp &amp; TikTok baru sudah baca JPG sebagai Live/Motion. IG Story tetap pakai MP4 agar gerak tidak hilang. Tahan lama tombol TikTok/WA untuk kirim versi MP4."
                    android:textColor="?attr/appTextMid"
                    android:textSize="13sp"
                    android:lineSpacingExtra="6dp" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Bagikan Foto Live (JPG) &amp; Video" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/btnTikTok"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_social_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Bagikan Foto Live JPG ke TikTok, tahan lama untuk MP4">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/logo_tiktok" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="TikTok" android:textColor="#FF111827" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnInstagram"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_social_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Tambahkan video ke Instagram Story">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/logo_instagram" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="IG Story" android:textColor="#FF111827" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnWhatsApp"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_social_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Bagikan Foto Live JPG ke WhatsApp, tahan lama untuk MP4">
                    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/logo_whatsapp" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="WA Status" android:textColor="#FF111827" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/appLine" />

    <!-- Action Buttons (Rounded Full Pill) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/appPaper"
        android:padding="18dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGallery"
            style="@style/Btn.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buka di Galeri"
            app:icon="@drawable/ic_gallery"
            app:iconTint="?attr/appIconTint"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgain"
                style="@style/Btn.Ghost"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="Buat Lagi"
                app:icon="@drawable/ic_add"
                app:iconTint="?attr/appIconTint"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Foto Live / Video"
                app:icon="@drawable/ic_share"
                app:iconTint="?attr/appOnInk"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
