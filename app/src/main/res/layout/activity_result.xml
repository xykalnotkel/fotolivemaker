<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/ink"
            android:contentDescription="Kembali" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Hasil"
            android:textColor="@color/text_hi"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- AREA TES: tahan untuk memutar -->
            <FrameLayout
                android:id="@+id/holdArea"
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:background="@drawable/bg_preview">

                <ImageView
                    android:id="@+id/still"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Foto diam" />

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:visibility="invisible"
                    app:use_controller="false"
                    app:resize_mode="fit" />

                <LinearLayout
                    android:id="@+id/badgeLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="9dp"
                    android:paddingEnd="11dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:id="@+id/badgeIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_livephoto"
                        app:tint="@color/on_ink"
                        android:contentDescription="Live Photo" />

                    <TextView
                        android:id="@+id/badgeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="LIVE"
                        android:textColor="@color/on_ink"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <!-- tombol mode di kanan atas -->
                <LinearLayout
                    android:id="@+id/modeBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_pill_outline"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/modeStatic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="Statis"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/modeLive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="Live"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/modeLoop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="Ulangi"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hintHold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_pill_outline"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Tahan untuk memutar"
                    android:textColor="@color/ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- status utama -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@color/ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Memeriksa…"
                        android:textColor="@color/text_hi"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/statusSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tersimpan di DCIM/Camera"
                        android:textColor="@color/text_mid"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnRecheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Cek ulang"
                    android:textColor="@color/ink"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- rincian pemeriksaan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hasil pemeriksaan" />

                <TextView
                    android:id="@+id/chkStruct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_mid"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chkVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_mid"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chkSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_mid"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="8dp"
                android:text="Lihat detail teknis"
                android:textColor="@color/text_mid"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/text_mid"
                android:lineSpacingExtra="3dp" />

            <!-- langkah tes, dengan ilustrasi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/illusResult"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginBottom="18dp"
                    android:src="@drawable/illus_hold"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="Tahan layar" />

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Langkah tes" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="1.  Buka TikTok, tekan tombol +\n2.  Pilih tab Upload, cari fotonya\n3.  Kalau ada label Live, berhasil\n4.  Jangan lewat tombol Bagikan"
                    android:textColor="@color/text_mid"
                    android:textSize="13sp"
                    android:lineSpacingExtra="6dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/line" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Hasilnya cuma foto diam?"
                    android:textColor="@color/text_hi"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Jangan pakai tombol Bagikan. Pilih berkasnya langsung dari galeri di TikTok (+ lalu Upload).\n\nKalau mau tambah filter/beauty TikTok, export ulang tanpa Bersih &amp; Stabil. Filter mereka menumpuk di atas efek kita jadi kelihatan aneh."
                    android:textColor="@color/text_dim"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/paper"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGallery"
            style="@style/Btn.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buka di Galeri" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgain"
                style="@style/Btn.Ghost"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="Buat Lagi" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Bagikan" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
