<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="10dp"
    android:padding="10dp"
    android:background="@drawable/bg_card"
    android:foreground="?attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="62dp"
        android:layout_height="62dp">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/paper_dim"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:src="@drawable/ic_livephoto"
            app:tint="@color/on_ink"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="middle"
            android:textColor="@color/text_hi"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <ImageView
        android:id="@+id/more"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="10dp"
        android:src="@drawable/ic_more"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/text_dim"
        android:contentDescription="Opsi" />
</LinearLayout>
