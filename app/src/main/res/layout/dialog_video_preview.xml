<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup"
    android:padding="0dp">

    <TextView
        android:id="@+id/tvPreviewName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:text="Preview Video"
        android:textColor="?attr/appTextHigh"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_preview">

        <androidx.media3.ui.PlayerView
            android:id="@+id/previewPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="true"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            android:contentDescription="Preview video" />

    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:text="Putar video untuk preview. Tap EDIT untuk lanjut ke editor."
        android:textColor="?attr/appTextDim"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="16dp">

        <android.widget.Button
            android:id="@+id/btnPreviewCancel"
            style="@style/Btn.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:minWidth="100dp"
            android:text="Batal" />

        <android.widget.Button
            android:id="@+id/btnPreviewEdit"
            style="@style/Btn.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="100dp"
            android:text="Edit" />

    </LinearLayout>

</LinearLayout>